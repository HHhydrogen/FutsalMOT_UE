{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futsalmot.local/schemas/v1/frame_annotation.schema.json",
  "title": "FutsalMOT per-camera frame annotations v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "dataset_id", "dataset_version", "seed_id", "camera_id", "frame_index", "source_step", "time_seconds", "pose_schema_id", "camera_state", "objects"],
  "properties": {
    "schema": {"const": "futsalmot_frame_annotation"}, "schema_version": {"const": "1.0.0"},
    "dataset_id": {"type": "string", "minLength": 1}, "dataset_version": {"type": "string", "minLength": 1},
    "seed_id": {"type": "string", "pattern": "^seed_[0-9a-f]{8}$"}, "camera_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
    "frame_index": {"type": "integer", "minimum": 1}, "source_step": {"type": "integer", "minimum": 0}, "time_seconds": {"type": "number", "minimum": 0},
    "pose_schema_id": {"const": "futsal_body12_v1"}, "camera_state": {"$ref": "camera_state.schema.json"},
    "objects": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/player"}}
  },
  "$defs": {
    "bbox": {"oneOf": [{"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}, {"type": "null"}]},
    "keypoint": {
      "type": "object", "additionalProperties": false, "required": ["name", "x_px", "y_px", "visibility"],
      "properties": {"name": {"enum": ["left_shoulder", "right_shoulder", "left_elbow", "right_elbow", "left_wrist", "right_wrist", "left_hip", "right_hip", "left_knee", "right_knee", "left_ankle", "right_ankle"]}, "x_px": {"oneOf": [{"type": "number"}, {"type": "null"}]}, "y_px": {"oneOf": [{"type": "number"}, {"type": "null"}]}, "visibility": {"enum": [0, 1, 2]}}
    },
    "player": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "track_id", "class", "team", "role", "jersey_number", "bbox_xyxy", "bbox_source", "visible_pixel_count", "truncated", "visibility", "instance_mask_id", "number_mask_id", "jersey_number_visible", "jersey_number_readable", "jersey_number_view", "jersey_number_bbox_xyxy", "keypoints"],
      "properties": {
        "entity_id": {"enum": ["L0", "L1", "L2", "L3", "L4", "R0", "R1", "R2", "R3", "R4"]}, "track_id": {"type": "integer", "minimum": 1, "maximum": 10}, "class": {"const": "player"},
        "team": {"enum": ["L", "R"]}, "role": {"enum": ["player", "goalkeeper"]}, "jersey_number": {"type": "integer", "minimum": 1, "maximum": 99},
        "bbox_xyxy": {"$ref": "#/$defs/bbox"}, "bbox_source": {"enum": ["instance_mask", "not_visible"]}, "visible_pixel_count": {"type": "integer", "minimum": 0}, "truncated": {"type": "boolean"}, "visibility": {"enum": ["visible", "occluded", "out_of_frame", "unknown"]},
        "instance_mask_id": {"type": "integer", "minimum": 1, "maximum": 10}, "number_mask_id": {"type": "integer", "minimum": 32, "maximum": 41},
        "jersey_number_visible": {"type": "boolean"}, "jersey_number_readable": {"type": "boolean"}, "jersey_number_view": {"enum": ["front", "back", "side", "unknown"]}, "jersey_number_bbox_xyxy": {"$ref": "#/$defs/bbox"},
        "keypoints": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/keypoint"}}
      }
    }
  }
}
